# Opcional, só para desenvolvimento. O normal é salvar as chaves pela tela de
# Configurações (ícone da bandeja), que as guarda no cofre do Windows.
# Se usar: copie este arquivo para .env e preencha. O .env nunca vai para o Git.
# Com as duas chaves, o app usa o Groq e cai para o Gemini se o Groq falhar.

# Principal (rápido). Chave gratuita: https://console.groq.com/keys
GROQ_API_KEY=

# Reserva. Chave gratuita: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Os modelos agora são escolhidos na tela de Configurações.
