# Copie este arquivo para .env e preencha. O .env nunca vai para o Git.
# Com as duas chaves, o app usa o Groq e cai para o Gemini se o Groq falhar.

# Principal (rápido). Chave gratuita: https://console.groq.com/keys
GROQ_API_KEY=
# Opcional. Padrão: openai/gpt-oss-20b
# GROQ_MODEL=openai/gpt-oss-20b

# Reserva. Chave gratuita: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional. Padrão: gemini-3.5-flash
# GEMINI_MODEL=gemini-3.5-flash
